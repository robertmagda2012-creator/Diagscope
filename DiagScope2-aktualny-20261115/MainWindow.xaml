<Window x:Class="DiagScope2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DiagScope 2.0" Icon="DiagScope.ico" Width="860" Height="610" MinWidth="680" MinHeight="460" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#091321" Foreground="White" FontFamily="Segoe UI" FontSize="16">
<Window.Resources>
<SolidColorBrush x:Key="SurfaceText" Color="#FFFFFF"/>
<SolidColorBrush x:Key="SurfaceCard" Color="#101F32"/>
<SolidColorBrush x:Key="SurfaceBorder" Color="#304760"/>
<SolidColorBrush x:Key="InputFill" Color="#15283F"/>
<SolidColorBrush x:Key="InputBorder" Color="#4B6582"/>
<SolidColorBrush x:Key="InputHover" Color="#234669"/>
<SolidColorBrush x:Key="InputFocus" Color="#88CCFF"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SurfaceText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource SurfaceText}"/><Setter Property="Background" Value="{DynamicResource InputFill}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,11"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource InputHover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource InputFocus}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource SurfaceText}"/><Setter Property="Background" Value="{DynamicResource InputFill}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="CaretBrush" Value="{DynamicResource SurfaceText}"/><Setter Property="SelectionBrush" Value="#327DBB"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource SurfaceText}"/><Setter Property="Margin" Value="0,8,12,8"/></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#0B1727"/><Setter Property="Background" Value="#E9F3FF"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
<Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource SurfaceText}"/></Style>
</Window.Resources>
<DockPanel Margin="20,15"><Grid DockPanel.Dock="Top" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Canvas Width="58" Height="58" Margin="0,0,12,0"><Ellipse Width="48" Height="48" Canvas.Left="5" Canvas.Top="5" Stroke="#55ADFF" StrokeThickness="2"/><Ellipse Width="32" Height="32" Canvas.Left="13" Canvas.Top="13" Stroke="#55ADFF"/><Path Data="M29,0 L29,14 M29,44 L29,58 M0,29 L14,29 M44,29 L58,29 M8,31 L20,31 L25,20 L32,42 L38,27 L50,27" Stroke="White" StrokeThickness="2"/></Canvas><TextBlock FontSize="34" FontWeight="Bold" VerticalAlignment="Center"><Run Text="Diag"/><Run Text="Scope" Foreground="#55ADFF"/></TextBlock></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
  <TextBlock x:Name="StorageState" VerticalAlignment="Center" MaxWidth="270" FontSize="13" Text="Lokalnie · offline · 2.0"/>
  <Button Content="−" AutomationProperties.Name="Minimalizuj DiagScope" ToolTip="Minimalizuj DiagScope"
          Click="MinimizeApp" Margin="10,0,0,0" Padding="9,4" MinWidth="30"/>
</StackPanel></Grid>
<WrapPanel x:Name="Nav" DockPanel.Dock="Top" Margin="0,0,0,16">
  <WrapPanel.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
  </WrapPanel.Resources>
  <Button Tag="Pojazdy" Click="OnNavigationClick" ToolTip="Pojazdy" AutomationProperties.Name="Pojazdy">
    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" SnapsToDevicePixels="True" Stretch="Uniform" Stroke="#74BEFF" StrokeThickness="1.4" VerticalAlignment="Center" Data="M2,11 L2,8 L4,7 L5,4 L11,4 L12,7 L14,8 L14,11 Z M4,11 L4,13 M12,11 L12,13 M4,7 L12,7"/>
      <TextBlock Text="Pojazdy" Margin="8,0,0,0"/>
    </StackPanel>
  </Button>
  <Button Content="Pomiary" Tag="Pomiary" Click="OnNavigationClick"/>
  <Button Content="Analizator logów" Tag="Analizator logów" Click="OnNavigationClick"/>
  <Button Content="Diagnostyka" Tag="Diagnostyka" Click="OnNavigationClick"/>
  <Button Content="Wyniki" Tag="Wyniki" Click="OnNavigationClick"/>
  <Button Tag="Ustawienia" Click="OnNavigationClick" ToolTip="Ustawienia" AutomationProperties.Name="Ustawienia">
    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" SnapsToDevicePixels="True" Stretch="Uniform" Stroke="#74BEFF" StrokeThickness="1.4" VerticalAlignment="Center" Data="M8,3 A5,5 0 1 0 8,13 A5,5 0 1 0 8,3 M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 M8,0 L8,3 M8,13 L8,16 M0,8 L3,8 M13,8 L16,8 M2,2 L4,4 M12,12 L14,14 M14,2 L12,4 M4,12 L2,14"/>
    </StackPanel>
  </Button>
</WrapPanel>
<Border DockPanel.Dock="Bottom" BorderBrush="#304760" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><TextBlock x:Name="Footer" FontSize="12" Text="DiagScope 2.0 · Dane lokalne · Brak połączenia ze sterownikami"/></Border>
<Border Background="#EDF4FA" CornerRadius="10" Padding="14,12,12,7">
<Border.Resources>
<SolidColorBrush x:Key="SurfaceText" Color="#152B43"/>
<SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF"/>
<SolidColorBrush x:Key="SurfaceBorder" Color="#D6E2EF"/>
<SolidColorBrush x:Key="InputFill" Color="#F6FAFF"/>
<SolidColorBrush x:Key="InputBorder" Color="#B5CADF"/>
<SolidColorBrush x:Key="InputHover" Color="#E0EFFD"/>
<SolidColorBrush x:Key="InputFocus" Color="#2478C5"/>
<Style x:Key="FaultRow" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="#152B43"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="ToggleButton">
        <Border x:Name="RowSurface" Background="#FFFFFF" BorderBrush="#D6E2EF" BorderThickness="0,0,0,1">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#F1F7FE"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EBF3FC"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#2478C5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>
</Border.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page"/></ScrollViewer>
</Border>
</DockPanel></Window>